DATABASE_URL="file:./dev.db"

# Only needed for "html" scrape sources (Claude reads the page to extract
# events). Get a key at https://console.anthropic.com — leave unset if you
# only use ics/json sources.
# ANTHROPIC_API_KEY=

# Protects GET /api/scrape in production. Required in any deployed
# environment; the scheduler calling it must send
# `Authorization: Bearer <this value>`.
# SCRAPE_CRON_SECRET=
